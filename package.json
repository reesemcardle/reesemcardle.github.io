{
  "name": "reese-field-notes",
  "private": true,
  "scripts": {
    "deploy": "node scripts/deploy.mjs",
    "review-targets": "node scripts/review-targets.mjs",
    "update-content": "node scripts/update-content.mjs",
    "build:maps": "node scripts/build-water-maps.mjs && node scripts/build-regional-maps.mjs && node scripts/build-sailing-web.mjs",
    "build:regions": "node scripts/build-regional-maps.mjs && node scripts/build-sailing-web.mjs",
    "build:harbor": "node scripts/build-harbor-map.mjs && node scripts/build-sailing-web.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/smoke-playwright.mjs",
    "build:sailing-web": "node scripts/build-sailing-web.mjs",
    "preview": "python3 scripts/preview.py",
    "update-metadata": "node scripts/update-metadata.mjs"
  },
  "devDependencies": {
    "@turf/buffer": "7.3.0",
    "@xmldom/xmldom": "0.9.12",
    "chart.js": "4.4.9",
    "exifr": "7.1.3",
    "marked": "15.0.12",
    "osmtogeojson": "3.0.0-beta.5",
    "polygon-clipping": "0.15.7",
    "sanitize-html": "2.17.0",
    "sharp": "0.34.5"
  }
}
